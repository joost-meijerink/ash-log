    "steps": [
      {
        "questId": "Icthlarin's Little Helper",
        "added": [
          {
            "id": "Icthlarin's Little Helper:s:1896ef81",
            "text": "There will be three green circles on your map. North of the camp, you'll need to find Brialka the historian councillor. South of the camp, you will find Chirot the Broker Councillor and Alabrais the Science Councillor. Each one will need to be convinced on abandoning Mark Day."
          },
          {
            "id": "Icthlarin's Little Helper:s:2ab20ff5",
            "text": "Alabrais the Science Councillor: Fuzan's aim is to control you, like his KotHaar. There is only evidence Fuzan destroys. Fuzan's constant is control of others"
          },
          {
            "id": "Icthlarin's Little Helper:s:5369c021",
            "text": "Chirot the Broker Councillor: Fuzan's actions have cost you money. Before or after Fuzan takes his cut? Fuzan will steal what you wish to steal"
          }
        ],
        "removed": [
          {
            "id": "Icthlarin's Little Helper:s:c9ae1645",
            "text": "There will be three green circles on your map. North of the camp, you'll need to find Brialka the historian councillor, Chirot the Broker Councillor and Alabrais the Science Councillor. Each one will need to be convinced on abandoning Mark Day."
          },
          {
            "id": "Icthlarin's Little Helper:s:0e90cb99",
            "text": "Alabrais the Science Councillor: Fuzan's Aim to control you. There is only evidence Fuzan destroys. Fuzan's constant is control over others"
          },
          {
            "id": "Icthlarin's Little Helper:s:0ae61907",
            "text": "Chirot the Broker Councillor: Lose money on the deal. Fuzan takes a cut. Fuzan will steal what you plan to steal"
          }
        ]
      },
      {
        "questId": "The Wild Hunt",
        "added": [
          {
            "id": "The Wild Hunt:s:edd33d0b",
            "text": "To begin this quest, speak to Vannaka who can be found west of Cathan's location in the Bleakfields Valley region of Fellhollow. He will explain to you how nature spirits are dying out due to the nature of this region and he tasks you to find nature spirits and defeat them to collect their primordial hearts. These spirits can only be found in Willow groves at or around the western area of Fellhollow and will look like white glowing terrorbirds. If you aren't up to looking all over for them, you can find one near the northwestern area of the druid's circle in the Emberwood area, one in the Dragon's Run area, and another in the southern section of Witchwillow Range."
          }
        ],
        "removed": [
          {
            "id": "The Wild Hunt:s:a15d63cc",
            "text": "To begin this quest, speak to Vannaka who can be found west of Cathan's location in the Bleakfields Valley region of Fellhollow. He will explain to you how nature spirits are dying out due to the nature of this region and he tasks you to find nature spirits and defeat them to collect their primordial hearts. These spirits can only be found in Willow groves at or around the western area of Fellhollow and will look like white glowing terrorbirds."
