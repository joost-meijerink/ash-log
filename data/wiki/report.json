          }
        ]
      },
      {
        "questId": "What Remains is Written",
        "added": [
          {
            "id": "What Remains is Written:s:fa5d2bc0",
            "text": "Speak to Abraxus The Eternal in Coalridge Pass just north of the fork in the road while wearing the full necromancer's gear. He will assume, at least from your clothes, that you are an apprentice of his and will require your aid. He will introduce himself quite arrogantly that you stand in the presence of \"Abraxus The Eternal, master of necromancy, Keeper of secrets, both occult and arcane\" and inform you that locals have ransacked his library and his most precious tomes have been spread across the eastern sub-regions. He tasks you to find them and bring them back, but not to read any of them. He claims that your mind is too young and too limited to contain the dreaded secrets within."
          }
        ],
        "removed": [
