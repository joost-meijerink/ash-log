# Ash Log: copy this file to .env and fill in your own details.
# .env stays on your own computer, it isn't in git.

# Needed for the sync (the Update from wiki button in the app, or npm run sync).
# The wiki wants to know who uses its API, so its admins can reach you if something
# goes wrong. Put your own e-mail address or a URL here (your GitHub page, for example).
# The sync refuses this example address.
WIKI_USER_AGENT="AshLog/1.0 (your-email@example.com)"

# Optional: a different port for the app (default 5199).
# APP_PORT=5199

# Optional: which address your phone gets with Live on Wi-Fi.
#   name  your computer's name, like https://my-pc.local:5199 (never changes)
#   ip    its address on your network, like https://192.168.1.23:5199
# Without this line: name for a Mac with an iPhone, ip otherwise.
# LIVE_ADDRESS=ip
