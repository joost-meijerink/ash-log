# Ash Log: kopieer dit bestand naar .env en vul je eigen gegevens in.
# .env blijft op je eigen computer, het staat niet in git.

# Nodig voor de sync (de knop Sync in de app, of npm run sync).
# De wiki wil weten wie zijn API gebruikt, zodat de beheerders je kunnen bereiken als er
# iets misgaat. Zet hier je eigen e-mailadres of een URL (bijvoorbeeld je GitHub-pagina).
# Met dit voorbeeldadres weigert de sync.
WIKI_USER_AGENT="AshLog/1.0 (jouw-email@example.com)"

# Optioneel: een andere poort voor de app (standaard 5199).
# APP_PORT=5199

# Optioneel: welk adres je telefoon krijgt bij Live op wifi.
#   name  de naam van je computer, zoals https://mijn-pc.local:5199 (blijft altijd hetzelfde)
#   ip    het adres in je netwerk, zoals https://192.168.1.23:5199
# Zonder deze regel: name voor een Mac met iPhone, anders ip.
# LIVE_ADDRESS=ip
